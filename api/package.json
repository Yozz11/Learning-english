{
  "name": "@english-coach/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "db:export": "wrangler d1 export DB --local --output .wrangler/backup-local.sql",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@english-coach/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
