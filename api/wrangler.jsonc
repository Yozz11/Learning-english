{
  // Un solo Worker sirve la API (/api/*) y la web ya compilada (web/dist).
  "name": "english-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // La app vive en https://english-coach.yulianogarzon03.workers.dev
  // (las preview URLs quedan apagadas: no las necesito y son más puertas abiertas).
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-coach",
      "database_id": "d360ff10-f7cf-4213-b275-e73e4a4dc41f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Tope diario de llamadas a la IA, para que un bug no gaste la cuota gratis.
    "AI_DAILY_LIMIT": "200"
  },
  "observability": {
    "enabled": true
  }
}
