{
  // Un solo Worker sirve la API (/api/*) y la web ya compilada (web/dist).
  "name": "english-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-coach",
      "database_id": "PON_AQUI_EL_ID_DE_TU_BASE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Tope diario de llamadas a la IA, para que un bug no gaste la cuota gratis.
    "AI_DAILY_LIMIT": "200"
  },
  "observability": {
    "enabled": true
  }
}
